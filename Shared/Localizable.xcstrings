    "code.privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share a daily time, grace period and optional time zone. Invitations and check-ins stay private."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "口令只含每日时间、宽限和可选时区。配对与签到记录保持私密。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "口令只含每日時間、寬限和選填時區。配對與簽到紀錄保持私密。"
          }
        }
      }
    },
    "code.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Daily at %@ · %d min grace"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每日 %@ · 宽限 %d 分钟"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每日 %@ · 寬限 %d 分鐘"
          }
        }
      }
    },
