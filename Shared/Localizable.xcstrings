    "contacts.revokePending": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting to revoke sharing in iCloud. Ask the other person to check their device if needed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待同步撤销。必要时请另外通知对方检查设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等待同步撤銷。必要時請另外通知對方檢查裝置。"
          }
        }
      }
