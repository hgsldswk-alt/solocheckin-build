    "contacts.testHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask your contact to open the test and tap “I got it.”"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请对方打开测试提醒并点「我收到了」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請對方開啟測試提醒並點「我收到了」。"
          }
        }
      }
    },
    "contacts.testQueued": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Test saved. Waiting for the other person to sync and confirm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测试已保存，等待对方同步并确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
