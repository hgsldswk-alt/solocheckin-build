    "contacts.address": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Their iCloud email or phone number"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方 iCloud 邮箱或手机号"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對方的 iCloud 電郵或手機號碼"
          }
        }
      }
    },
    "contacts.addressHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple uses this address to find the invited account. The app doesn’t save the address. Each person needs the app and iCloud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 用这个地址查找受邀账号，App 不保存地址。双方都需要安装 App 并登录 iCloud。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 用這個地址查找受邀帳號，App 不會儲存地址。雙方都需要安裝 App 並登入 iCloud。"
          }
        }
      }
    },
    "contacts.alias": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Their name on your device"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给对方备注"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在這部裝置上稱呼對方"
          }
        }
      }
    },
    "contacts.confirmedAt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last confirmed %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近确认 %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最近確認 %@"
          }
        }
      }
    },
    "contacts.contacting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They’ll follow up on the check-in due %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方会联系你，核对 %@ 的签到。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對方會聯絡你，核對 %@ 的簽到。"
          }
        }
      }
    },
    "contacts.coverage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scheduled through %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "排程覆盖至 %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "排程涵蓋至 %@"
          }
        }
      }
    },
    "contacts.disconnect": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Disconnect"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "断开配对"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "中斷配對"
          }
        }
      }
    },
    "contacts.disconnectHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Previously scheduled reminders can still appear on the other device until it syncs or its schedule runs out."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方设备在同步或排程到期前，仍可能出现旧提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對方裝置在同步或排程到期前，仍可能出現舊提醒。"
          }
        }
      }
    },
    "contacts.invitationText": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could you look out for my check-in? If the agreed time passes, you’ll get a prompt to check. Receiving is always free."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "帮我看一下签到。约定时间过后，你会收到核对提示。接收永久免费。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "幫我留意簽到。約定時間過後，你會收到核對提示。接收永久免費。"
          }
        }
      }
    },
    "contacts.invite": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邀请"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "邀請"
          }
        }
      }
    },
    "contacts.lead": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agree on a time together, then try a test reminder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一起约好时间，再试一次提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一起約好時間，再試一次提醒。"
          }
        }
      }
    },
    "contacts.network": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both people use this app. Reminders depend on iCloud, the network, and the other iPhone’s notification and power settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双方都需要安装 App。提醒取决于 iCloud、网络，以及对方 iPhone 的通知和开机状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "雙方都需要安裝 App。提醒取決於 iCloud、網路，以及對方 iPhone 的通知和開機狀態。"
          }
        }
      }
    },
    "contacts.nickname": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your name they’ll see"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向对方显示的名字"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "向對方顯示的名字"
          }
        }
      }
    },
    "contacts.none": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No contacts yet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
