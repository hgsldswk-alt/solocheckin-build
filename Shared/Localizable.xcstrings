{
  "sourceLanguage": "en",
  "strings": {
    "app.name": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo Check-In"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "独居签到"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "獨居簽到"
          }
        }
      }
    },
    "clock.confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm device time"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认设备时间"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認裝置時間"
          }
        }
      }
    },
    "clock.warning": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device clock changed. Check the time before syncing. Existing reminders may still appear."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备时间有变动。请核对后再同步，已排好的提醒可能仍会出现。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置時間有變動。請核對後再同步，已排好的提醒可能仍會出現。"
          }
        }
      }
    },
